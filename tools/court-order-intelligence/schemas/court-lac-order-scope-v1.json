          "language"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "language": {
            "$ref": "#/$defs/fact"
          },
          "villageRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "awardRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parcelRefs": {
            "type": "array",
