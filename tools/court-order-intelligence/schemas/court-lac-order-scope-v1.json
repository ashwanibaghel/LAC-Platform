      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "rawText",
        "value",
        "state",
        "attribution",
        "scope",
        "evidenceIds"
      ],
      "properties": {
        "rawText": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "state": {
          "enum": [
            "Explicit",
            "NotStated",
            "NeedsReview"
          ]
        },
        "attribution": {
          "enum": [
            null,
            "COURT_DIRECTION",
            "COURT_FINDING",
            "COURT_OBSERVATION",
            "PETITIONER_SUBMISSION",
            "RESPONDENT_SUBMISSION",
            "HISTORICAL_QUOTATION",
            "OTHER"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
