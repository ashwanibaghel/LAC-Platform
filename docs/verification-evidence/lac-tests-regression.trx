      Executed DbCommand (2ms) [Parameters=[@documentId='?' (DbType = Guid), @input_SourceAwardId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT d."Id", d."AwardId", d."CoreDocumentRole", d."DocumentId", d."IsDetached", d."IsSharedSource", d."LegalDate", d."PartNumber", d."PossessionEventId", d."ReferenceNumber", d."Remarks", d."Revision", d."Title", d."VillageId", d0."Id", d0."CreatedAt", d0."CreatedBy", d0."DocumentType", d0."FileSize", d0."MimeType", d0."OriginalFileName", d0."RecordStatus", d0."Remarks", d0."Sha256Hash", d0."Status", d0."StoragePath", d0."UpdatedAt", d0."UpdatedBy", d0."UploadedAt", d0."UploadedBy", d0."Version"&#xD;
