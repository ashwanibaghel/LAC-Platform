      Executed DbCommand (7ms) [Parameters=[@documentId='?' (DbType = Guid), @hash='?', @selectedAwardId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT d."Id", d."AwardId", d."CoreDocumentRole", d."DocumentId", d."IsDetached", d."IsSharedSource", d."LegalDate", d."PartNumber", d."PossessionEventId", d."ReferenceNumber", d."Remarks", d."Revision", d."Title", d."VillageId", d0."Id", d0."CreatedAt", d0."CreatedBy", d0."DocumentType", d0."FileSize", d0."MimeType", d0."OriginalFileName", d0."RecordStatus", d0."Remarks", d0."Sha256Hash", d0."Status", d0."StoragePath", d0."UpdatedAt", d0."UpdatedBy", d0."UploadedAt", d0."UploadedBy", d0."Version", a."Id", a."AcquisitionProjectId", a."ActRegime", a."ArchiveKind", a."AwardDate", a."AwardNumber", a."AwardType", a."CreatedAt", a."CreatedBy", a."ParentAwardId", a."ParentAwardReference", a."Purpose", a."RecordStatus", a."Remarks", a."Revision", a."Status", a."UpdatedAt", a."UpdatedBy", s."Id", s."AwardId", s."VillageId", s."Id0", s."CreatedAt", s."CreatedBy", s."Name", s."RecordStatus", s."SubDivisionId", s."UpdatedAt", s."UpdatedBy"&#xD;
      FROM "DocumentAwards" AS d&#xD;
      INNER JOIN "Documents" AS d0 ON d."DocumentId" = d0."Id"&#xD;
      INNER JOIN "Awards" AS a ON d."AwardId" = a."Id"&#xD;
      LEFT JOIN (&#xD;
          SELECT a0."Id", a0."AwardId", a0."VillageId", v."Id" AS "Id0", v."CreatedAt", v."CreatedBy", v."Name", v."RecordStatus", v."SubDivisionId", v."UpdatedAt", v."UpdatedBy"&#xD;
          FROM "AwardVillages" AS a0&#xD;
          INNER JOIN "Villages" AS v ON a0."VillageId" = v."Id"&#xD;
      ) AS s ON a."Id" = s."AwardId"&#xD;
      WHERE (d."DocumentId" = @documentId OR (d0."Sha256Hash" IS NOT NULL AND lower(d0."Sha256Hash") = @hash)) AND NOT (d."IsDetached") AND d."AwardId" &lt;&gt; @selectedAwardId&#xD;
      ORDER BY d."AwardId", d."Id", d0."Id", a."Id", s."Id"&#xD;
