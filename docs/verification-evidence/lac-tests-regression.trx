      FROM "DocumentAwards" AS d&#xD;
      INNER JOIN "Documents" AS d0 ON d."DocumentId" = d0."Id"&#xD;
      INNER JOIN "Awards" AS a ON d."AwardId" = a."Id"&#xD;
      WHERE (d."DocumentId" = @documentId OR (d0."Sha256Hash" IS NOT NULL AND lower(d0."Sha256Hash") = @hash)) AND d."AwardId" &lt;&gt; @targetAwardId&#xD;
