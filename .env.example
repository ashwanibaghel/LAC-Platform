# Do not commit a real .env file. Prefer user/machine environment variables on Windows.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=lac_platform;Username=lac_app;Password=REPLACE_WITH_LOCAL_SECRET;Pooling=true
Storage__DocumentRoot=C:\LAC-Data\Documents
Storage__ExtractionRoot=C:\LAC-Data\Extraction
Storage__BackupRoot=C:\LAC-Data\Backups
PdfImport__MaxFileSizeMb=250
PdfImport__MaxConcurrentJobs=1
Ocr__Enabled=true
Ocr__TesseractExecutable=C:\Program Files\Tesseract-OCR\tesseract.exe
Ocr__PdfToImageExecutable=REPLACE_WITH_LOCAL_PDFTOPPM_EXE
Ocr__Language=eng
# It must be an Npgsql PostgreSQL connection string with Host, Port, Database,
# Username, and Password supplied by the development-database administrator.
